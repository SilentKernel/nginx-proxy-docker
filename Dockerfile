# syntax=docker/dockerfile:1
# nginx-proxy on the official stable nginx (Debian trixie). Same layout as upstream's
# Dockerfile.debian (nginx-proxy 1.11.6), but the nginx comes from nginx:<series>-trixie with
# Debian's updates applied at every build, and docker-gen and forego are compiled here on our
# go-docker (current Go, our go/<tool>/go.mod). build.sh passes every image pinned by digest.
ARG BASE_IMAGE=nginx:1.30-trixie
ARG GO_BASE_IMAGE=registry.developpeur-freelance.io/silent/go-docker:1.27-trixie
ARG UPSTREAM_IMAGE=nginxproxy/nginx-proxy:1.11.6

# ---- docker-gen, from its upstream release commit -------------------------------------------------
FROM ${GO_BASE_IMAGE} AS build-docker-gen
ARG DOCKER_GEN_COMMIT
ARG DOCKER_GEN_VERSION
ARG GO_VERSION
ARG MIN_GO_VERSION
WORKDIR /src
RUN set -eu; \
    test -n "${DOCKER_GEN_COMMIT}"; \
    git init --quiet .; \
    git fetch --quiet --depth 1 https://github.com/nginx-proxy/docker-gen "${DOCKER_GEN_COMMIT}"; \
    git checkout --quiet FETCH_HEAD; \
    [ "$(git rev-parse HEAD)" = "${DOCKER_GEN_COMMIT}" ] || { echo "fetched $(git rev-parse HEAD), not ${DOCKER_GEN_COMMIT}" >&2; exit 1; }
# Our module files (scripts/update-go-deps.sh): upstream's, with the fixed modules of versions.env.
# Generated for one commit: refused for any other (rerun the script after a commit change).
COPY go/docker-gen/go.mod go/docker-gen/go.sum ./
RUN set -eu; \
    head -1 go.mod | grep -qxF "// generated by scripts/update-go-deps.sh for ${DOCKER_GEN_COMMIT}: do not edit" \
        || { echo "go/docker-gen/go.mod was not generated for ${DOCKER_GEN_COMMIT}: run scripts/update-go-deps.sh" >&2; exit 1; }; \
    go mod download; \
    go mod verify
# Upstream's tests, on our modules. TestGetCurrentContainerEmpty is skipped: it expects not to run in
# a container, and a docker build is one (it fails the same way on upstream's own module files).
RUN go test -mod=readonly -count=1 -skip '^TestGetCurrentContainerEmpty$' ./...
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath \
        -ldflags "-s -w -X main.buildVersion=${DOCKER_GEN_VERSION}" -o /out/docker-gen ./cmd/docker-gen
COPY scripts/go-guard.sh /usr/local/bin/go-guard.sh
RUN go-guard.sh /out/docker-gen

# ---- forego, from its upstream release commit ------------------------------------------------------
FROM ${GO_BASE_IMAGE} AS build-forego
ARG FOREGO_COMMIT
ARG FOREGO_VERSION
ARG GO_VERSION
ARG MIN_GO_VERSION
WORKDIR /src
RUN set -eu; \
    test -n "${FOREGO_COMMIT}"; \
    git init --quiet .; \
    git fetch --quiet --depth 1 https://github.com/nginx-proxy/forego "${FOREGO_COMMIT}"; \
    git checkout --quiet FETCH_HEAD; \
    [ "$(git rev-parse HEAD)" = "${FOREGO_COMMIT}" ] || { echo "fetched $(git rev-parse HEAD), not ${FOREGO_COMMIT}" >&2; exit 1; }
COPY go/forego/go.mod go/forego/go.sum ./
RUN set -eu; \
    head -1 go.mod | grep -qxF "// generated by scripts/update-go-deps.sh for ${FOREGO_COMMIT}: do not edit" \
        || { echo "go/forego/go.mod was not generated for ${FOREGO_COMMIT}: run scripts/update-go-deps.sh" >&2; exit 1; }; \
    go mod download; \
    go mod verify
RUN go test -mod=readonly -count=1 ./...
# main.Version (version.go): upstream's Dockerfile sets main.buildVersion, which forego does not have.
RUN CGO_ENABLED=0 go build -mod=readonly -trimpath \
        -ldflags "-s -w -X main.Version=${FOREGO_VERSION}" -o /out/forego .
COPY scripts/go-guard.sh /usr/local/bin/go-guard.sh
RUN go-guard.sh /out/forego

FROM ${UPSTREAM_IMAGE} AS upstream

# ---- the image ------------------------------------------------------------------------------------
FROM ${BASE_IMAGE}

ARG NGINX_VERSION
ARG MIN_NGINX_VERSION
ARG NGINX_PROXY_VERSION
ARG DOCKER_GEN_VERSION

# Debian security fixes without waiting for the official image to be rebuilt; never cached (build.sh
# builds with --no-cache), tests/os-updates.sh then checks none is left. The official image removes
# nginx.org's apt source after installing nginx: this cannot move nginx (see nginx-redirect-docker).
RUN set -eu; \
    apt-get update -o APT::Update::Error-Mode=any; \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade -y -o Dpkg::Options::=--force-confold; \
    rm -rf /var/lib/apt/lists/*

# Refuse to produce a vulnerable image: the nginx binary must be the version build.sh expects and
# not below the floor (versions.env).
RUN set -eu; \
    test -n "${NGINX_VERSION}" && test -n "${MIN_NGINX_VERSION}"; \
    actual="$(nginx -v 2>&1 | sed -n 's|^nginx version: nginx/||p')"; \
    echo "nginx ${actual} expected=${NGINX_VERSION} required>=${MIN_NGINX_VERSION}"; \
    [ "${actual}" = "${NGINX_VERSION}" ] || { echo "nginx is ${actual}, not ${NGINX_VERSION}" >&2; exit 1; }; \
    lowest="$(printf '%s\n%s\n' "${actual}" "${MIN_NGINX_VERSION}" | sort -t. -k1,1n -k2,2n -k3,3n | head -1)"; \
    if [ "${lowest}" != "${MIN_NGINX_VERSION}" ]; then \
        echo "nginx ${actual} is older than ${MIN_NGINX_VERSION}: refusing to build a vulnerable image" >&2; \
        exit 1; \
    fi

# acme-companion reads DOCKER_GEN_VERSION (its value does not matter, upstream's comment);
# docker-gen reads the Docker socket the compose file mounts at /tmp/docker.sock.
ENV NGINX_PROXY_VERSION=${NGINX_PROXY_VERSION} \
    DOCKER_GEN_VERSION=${DOCKER_GEN_VERSION} \
    DOCKER_HOST=unix:///tmp/docker.sock

# Upstream's nginx.conf changes, verbatim (Dockerfile.debian of nginx-proxy 1.11.6).
RUN echo "\ninclude /etc/nginx/toplevel.conf.d/*.conf;" >> /etc/nginx/nginx.conf \
   && sed -i 's/worker_connections.*;$/worker_connections  10240;/' /etc/nginx/nginx.conf \
   && sed -i -e '/^\}$/{s//\}\nworker_rlimit_nofile 20480;/;:a' -e '$!N;$!ba' -e '}' /etc/nginx/nginx.conf \
   && mkdir -p '/etc/nginx/toplevel.conf.d' \
   && mkdir -p '/etc/nginx/dhparam' \
   && mkdir -p '/etc/nginx/certs' \
   && mkdir -p '/usr/share/nginx/html/errors'

COPY --from=build-forego /out/forego /usr/local/bin/forego
COPY --from=build-docker-gen /out/docker-gen /usr/local/bin/docker-gen
COPY --from=upstream /etc/nginx/network_internal.conf /etc/nginx/network_internal.conf
COPY --from=upstream /app/ /app/
WORKDIR /app/

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["forego", "start", "-r"]
