# Single source of every setting in this repo. build.sh sources it and passes it to the Dockerfile.
#
# nginx-proxy (https://github.com/nginx-proxy/nginx-proxy) rebuilt on the official stable nginx:
# upstream's releases pin an nginx that falls behind (1.11.6 ships nginx 1.31.3, without the fixes of
# 14 Oct 2026). Each build starts FROM the official nginx:${NGINX_SERIES}-trixie (Debian), pulled
# fresh and pinned by digest, so every nginx 1.30.x fix lands without editing this file; the
# Dockerfile also runs `apt-get upgrade` for Debian's fixes.
# To build on a given official tag instead (rollback, reproducing a build):
#   NGINX_BASE_TAG=1.30.6-trixie ./build.sh

NGINX_SERIES=1.30

# Security floor, enforced inside the image at build time (Dockerfile) and by tests/guard.sh.
# Raise it by hand on an nginx security release, so nothing older can be built or pushed.
MIN_NGINX_VERSION=1.30.6

# Upstream nginx-proxy, from its own image (pinned by digest at build time):
#   NGINX_PROXY_VERSION  nginxproxy/nginx-proxy release whose /app we ship (entrypoint, Procfile,
#                        default nginx.tmpl, dhparam groups) and network_internal.conf. The server
#                        mounts its own nginx.tmpl (tests/fixtures/server-nginx.tmpl): when you move
#                        to a new release, port the server template to it first.
NGINX_PROXY_VERSION=1.11.6

# docker-gen (the config generator) and forego (the process manager) are compiled here, not taken
# from upstream's images: those are built with an old Go and old modules (17 fixable HIGH CVEs on
# 28 Oct 2026). Each is built from its upstream release commit (full SHA, checked after the fetch)
# on our go-docker image (../go-docker, read fresh and pinned by digest: every Go 1.27.x fix lands
# the night after go-docker publishes it), with our go/<tool>/go.mod + go.sum.
GO_BASE_IMAGE=registry.developpeur-freelance.io/silent/go-docker
GO_BASE_TAG=1.27-trixie
# Security floor of the Go that compiles them, enforced in the Dockerfile and by tests/guard.sh.
MIN_GO_VERSION=1.27.3

DOCKER_GEN_VERSION=0.17.2
DOCKER_GEN_COMMIT=497e50d07d3aa966d58223c80ff4280a6fde2510
FOREGO_VERSION=v0.18.8
FOREGO_COMMIT=8eb5e52b8b69c7315a2064a61749f93f731701a2

# Modules raised above what upstream requires at those commits (fixed CVEs). They are applied by
# scripts/update-go-deps.sh, which writes go/<tool>/go.mod + go.sum (never edited by hand); the
# build only uses those files. Drop an entry once upstream requires that version (or newer), then
# rerun scripts/update-go-deps.sh. Same after changing a commit above.
DOCKER_GEN_GO_GET="github.com/klauspost/compress@v1.18.7 github.com/moby/go-archive@v0.3.0 golang.org/x/crypto@v0.55.0"
FOREGO_GO_GET="golang.org/x/text@v0.41.0"

# Production runs amd64 only.
PLATFORM=linux/amd64

# Our registry. In CI it must equal $CI_REGISTRY_IMAGE.
IMAGE=registry.developpeur-freelance.io/silent/nginx-proxy-docker

# Vulnerability gate (tests/scan.sh, scripts/trivy-diff.py): severities that refuse a push when the
# candidate has a fixable one the published image has not. HIGH too (the other bases: CRITICAL
# only): the Go binaries are ours to keep current, and a regression there must not ship.
GATE_SEVERITIES=HIGH,CRITICAL
